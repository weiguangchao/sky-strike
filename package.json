{
  "name": "sky-strike",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "vite --host 0.0.0.0",
    "typecheck": "npm run lint && tsc --noEmit",
    "build": "npm run typecheck && npm run models:audit && npm run sprites:check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "worker:dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "models:build": "tsx scripts/models.ts && npm run models:build:archive",
    "models:build:archive": "tsx scripts/archive-models.ts",
    "models:audit": "tsx scripts/model-audit.ts",
    "sprites:build": "tsx scripts/sprites.ts",
    "sprites:check": "tsx scripts/check-sprites.ts",
    "lint": "tsx scripts/type-discipline.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.187.0",
    "pngjs": "^7.0.0",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "phaser": "4.2.1"
  }
}
